# Copy this file to .env and enter rotated development credentials locally.
FINNHUB_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/responses?api-version=preview
AZURE_OPENAI_MODEL=gpt-4.1

# Telegram values are optional until you enable the webhook integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PUBLIC_URL=
